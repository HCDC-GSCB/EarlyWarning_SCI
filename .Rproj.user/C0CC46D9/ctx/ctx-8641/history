group_by(Year) %>%
summarise(
Chi2_Stat = sum((Cases - Expected)^2 / (Expected + (Expected^2)/theta_val), na.rm = TRUE),
P_Value = 1 - pchisq(Chi2_Stat, df = 52),
.groups = "drop"
