library(MASS)
run_method_2 <- function(df) {
diseases <- unique(df$Disease)
res_data <- list()
plot_data <- list()
for (dis in diseases) {
df_dis <- df %>% filter(Disease == dis)
# 1. Fit mô hình khuôn 10 năm
nb_model <- tryCatch(glm.nb(Cases ~ as.factor(Week), data = df_dis), error = function(e) NULL)
if(is.null(nb_model)) next
# 2. Tính số ca kỳ vọng (Baseline)
df_fitted <- df_dis %>% mutate(Expected = predict(nb_model, newdata = df_dis, type = "response"))
theta_val <- nb_model$theta
# 3. Tính độ lệch Chi-square và P-Value
eval_res <- df_fitted %>%
group_by(Year) %>%
summarise(
Chi2_Stat = sum((Cases - Expected)^2 / (Expected + (Expected^2)/theta_val), na.rm = TRUE),
P_Value = 1 - pchisq(Chi2_Stat, df = 52),
.groups = "drop"
) %>%
mutate(
Disease = dis,
Status = ifelse(P_Value < 0.05, "Abnormal", "Normal"),
# Tạo nhãn dán sao (Significance stars) giống ggpubr
Sig_Label = case_when(
P_Value < 0.001 ~ "***",
P_Value < 0.01 ~ "**",
P_Value < 0.05 ~ "*",
TRUE ~ "ns"
),
# Ghép chữ p-value và sao để in lên biểu đồ
P_Text = paste0("p ", ifelse(P_Value < 0.001, "< 0.001", paste0("= ", format(round(P_Value, 3), nsmall = 3))), " ", Sig_Label)
)
res_data[[dis]] <- eval_res
plot_data[[dis]] <- df_fitted %>% left_join(eval_res %>% dplyr::select(Year, Status), by = "Year")
}
list(table = bind_rows(res_data), plot_df = bind_rows(plot_data))
}
res_m2 <- run_method_2(df_weekly)
