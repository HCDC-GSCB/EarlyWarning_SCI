tcm_cases <- load_data("https://docs.google.com/spreadsheets/d/1jSAuGFUkcHBL5iie999qn7ClW2dTYB3AOSOaRwOBCGY/edit?usp=sharing", "ca")
tcm_inp <- load_data("https://docs.google.com/spreadsheets/d/1jSAuGFUkcHBL5iie999qn7ClW2dTYB3AOSOaRwOBCGY/edit?usp=sharing", "noi")
tcm_sev <- load_data("https://docs.google.com/spreadsheets/d/1jSAuGFUkcHBL5iie999qn7ClW2dTYB3AOSOaRwOBCGY/edit?usp=sharing", "nang")
theme_hcdc_report <- function() {
theme_bw(base_size = 14) +
theme(
text = element_text(color = "black"),
axis.text = element_text(color = "black", size = 12),
axis.title = element_text(color = "black", size = 14, face = "bold"),
plot.title = element_text(color = "black", size = 16, face = "bold", hjust = 0.5),
plot.subtitle = element_text(color = "black", size = 13, hjust = 0.5, margin = margin(b = 10)),
legend.text = element_text(color = "black", size = 12),
legend.title = element_text(color = "black", size = 12, face = "bold"),
panel.grid.minor = element_blank(),
panel.grid.major = element_line(color = "gray85", linetype = "dashed"),
plot.background = element_rect(fill = "white", color = NA),
panel.background = element_rect(fill = "white", color = NA),
strip.text = element_text(color = "white", size = 14, face = "bold"),
strip.background = element_rect(fill = "#1D3557", color = NA)
)
}
tao_bang_gt <- function(df, title_text) {
df %>% gt() %>% tab_header(title = md(title_text)) %>% fmt_number(columns = where(is.numeric), decimals = 2)
}
get_weekly_data <- function(df_cases, disease_name) {
df_cases %>%
pivot_longer(cols = -Week, names_to = "Year", values_to = "Cases") %>%
mutate(Year = as.numeric(Year), Disease = disease_name) %>%
filter(Year != 2026) %>%
arrange(Year, Week)
}
df_weekly_sxh <- get_weekly_data(sxh_cases, "Dengue")
df_weekly_tcm <- get_weekly_data(tcm_cases, "HFMD")
df_weekly <- bind_rows(df_weekly_sxh, df_weekly_tcm)
#| label: m2-negative-binomial
#| warning: false
library(MASS)
run_method_2 <- function(df) {
diseases <- unique(df$Disease)
res_data <- list()
plot_data <- list()
for (dis in diseases) {
df_dis <- df %>% filter(Disease == dis)
nb_model <- tryCatch(glm.nb(Cases ~ as.factor(Week), data = df_dis), error = function(e) NULL)
if(is.null(nb_model)) next
df_fitted <- df_dis %>% mutate(Expected = predict(nb_model, type = "response"))
theta_val <- nb_model$theta
eval_res <- df_fitted %>%
group_by(Year) %>%
summarise(
Chi2_Stat = sum((Cases - Expected)^2 / (Expected + (Expected^2)/theta_val), na.rm = TRUE),
P_Value = 1 - pchisq(Chi2_Stat, df = 52),
.groups = "drop"
) %>%
mutate(Disease = dis, Status = ifelse(P_Value < 0.05, "Abnormal", "Normal"))
res_data[[dis]] <- eval_res
plot_data[[dis]] <- df_fitted %>% left_join(eval_res %>% select(Year, Status), by = "Year")
}
list(table = bind_rows(res_data), plot_df = bind_rows(plot_data))
}
res_m2 <- run_method_2(df_weekly)
View(df_weekly)
sum(is.na(df_weekly$Cases))
which(is.na(df_weekly$Cases))
