        "run_method_1 <- function(df, threshold_weeks = 8) {",
        "+ ",
        "  diseases <- unique(df$Disease)",
        "+ ",
        "  res_data <- list()",
        "+ ",
        "  plot_data <- list()",
        "+ ",
        "  ",
        "+ ",
        "  for (dis in diseases) {",
        "+ ",
        "    df_dis <- df %>% filter(Disease == dis)",
        "+ ",
        "    years <- unique(df_dis$Year)",
        "+ ",
        "    ",
        "+ ",
        "    for (y in years) {",
        "+ ",
        "      train_9yr <- df_dis %>% filter(Year != y)",
        "+ ",
        "      test_1yr <- df_dis %>% filter(Year == y)",
        "+ ",
        "      ",
        "+ ",
        "      percentiles <- train_9yr %>%",
        "+ ",
        "        group_by(Week) %>%",
        "+ ",
        "        summarise(",
        "+ ",
        "          P10 = quantile(Cases, 0.10, na.rm = TRUE), ",
        "+ ",
        "          P90 = quantile(Cases, 0.90, na.rm = TRUE),",
        "+ ",
        "          .groups = \"drop\"",
        "+ ",
        "        )",
        "+ ",
        "      ",
        "+ ",
        "      test_res <- test_1yr %>% left_join(percentiles, by = \"Week\")",
        "+ ",
        "      w_high <- sum(test_res$Cases > test_res$P90, na.rm = TRUE)",
        "+ ",
        "      w_low <- sum(test_res$Cases < test_res$P10, na.rm = TRUE)",
        "+ ",
        "      ",
        "+ ",
        "      status <- case_when(",
        "+ ",
        "        w_high >= threshold_weeks ~ \"Abnormal (High)\",",
        "+ ",
        "        w_low >= threshold_weeks ~ \"Abnormal (Low)\",",
        "+ ",
        "        TRUE ~ \"Normal\"",
        "+ ",
        "      )",
        "+ ",
        "      ",
        "+ ",
        "      res_data[[paste(dis, y)]] <- tibble(",
        "+ ",
        "        Disease = dis, Year = y, ",
        "+ ",
        "        Weeks_High = w_high, Weeks_Low = w_low, Status = status",
        "+ ",
        "      )",
        "+ ",
        "      plot_data[[paste(dis, y)]] <- test_res %>% mutate(Status_Year = status)",
        "+ ",
        "    }",
        "+ ",
        "  }",
        "+ ",
        "  list(table = bind_rows(res_data), plot_df = bind_rows(plot_data))",
        "+ ",
        "}",
